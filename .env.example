# ==========================================
# LINE Messaging API 憑證設定
# ==========================================
# 請填入 LINE 官方帳號後台或 LINE Developers 的 Channel Secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 請填入 LINE Developers 的 Messaging API 分頁發行的 Channel Access Token (長字串)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# ==========================================
# Google Gemini API 金鑰
# ==========================================
# 請前往 https://aistudio.google.com/ 取得
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 系統與 AI 設定
# ==========================================
PORT=5000
DEBUG=True
AI_SYSTEM_PROMPT=你是一位親切、聰明且熱心助人的繁體中文 AI 助理。請用生動、有條理且自然的繁體中文回答使用者的問題。
